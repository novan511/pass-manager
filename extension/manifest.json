{
  "manifest_version": 3,
  "name": "Keyring Vault",
  "version": "1.0.0",
  "description": "Autofill from your Keyring zero-knowledge vault.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Keyring Vault"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://localhost:3000/*", "https://*/*"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
